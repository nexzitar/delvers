[resource]
script = ExtResource("1_dungeon")
dungeon_id = "darkwood"
dungeon_name = "The Darkwood"
flavor = "Moonlit firs, goblin warbands, and the crowned thing in room ten."
length = 10
pool_core = Array[ExtResource("2_enemy")]([ExtResource("3_slime"), ExtResource("3_slime"), ExtResource("4_archer"), ExtResource("5_warrior"), ExtResource("8_scout")])
pool_deep = Array[ExtResource("2_enemy")]([ExtResource("6_spider"), ExtResource("6_spider"), ExtResource("9_shaman")])
deep_from = 3
guaranteed = Array[ExtResource("2_enemy")]([ExtResource("5_warrior"), ExtResource("3_slime")])
boss_pack = Array[ExtResource("2_enemy")]([ExtResource("7_king"), ExtResource("3_slime"), ExtResource("4_archer")])
mid_boss = Array[ExtResource("2_enemy")]([ExtResource("10_chief"), ExtResource("5_warrior"), ExtResource("9_shaman")])
level_offset = 0
rare_chance = 0.01
boss_epic_chance = 0.03
theme = "forest"
lore_ids = Array[String](["expedition_log_1", "expedition_log_2", "expedition_log_3", "expedition_log_4"])
