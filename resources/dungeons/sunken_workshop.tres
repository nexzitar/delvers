[resource]
script = ExtResource("1_dungeon")
dungeon_id = "sunken_workshop"
dungeon_name = "The Sunken Workshop"
flavor = "The old guild\'s flooded engine-halls. The machines never heard the news."
length = 10
pool_core = Array[ExtResource("2_enemy")]([ExtResource("6_mite"), ExtResource("6_mite"), ExtResource("4_slick"), ExtResource("5_thrower")])
pool_deep = Array[ExtResource("2_enemy")]([ExtResource("3_sentinel"), ExtResource("5_thrower")])
deep_from = 3
guaranteed = Array[ExtResource("2_enemy")]([ExtResource("3_sentinel"), ExtResource("4_slick")])
boss_pack = Array[ExtResource("2_enemy")]([ExtResource("7_foreman"), ExtResource("3_sentinel"), ExtResource("6_mite"), ExtResource("6_mite")])
level_offset = 20
rare_chance = 0.05
boss_epic_chance = 0.08
pack_bonus = 1
theme = "workshop"
lore_ids = Array[String](["workshop_log_1", "workshop_log_2", "workshop_log_3", "workshop_log_4"])
